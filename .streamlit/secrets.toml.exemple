# ═══════════════════════════════════════════════════════════════════════════
#  Identifiants SQL Server du tableau de bord
# ═══════════════════════════════════════════════════════════════════════════
#  1. Copier ce fichier sous le nom  secrets.toml  (dans ce même dossier .streamlit).
#  2. Remplir les valeurs ci-dessous, entre guillemets simples ' '.
#     Entre guillemets simples, tout s'écrit tel quel, y compris la barre \ .
#     (Seule exception : une valeur qui contient elle-même un guillemet simple
#      s'écrit entre guillemets doubles " ", et une barre \ s'y écrit alors \\ .)
#  Ne jamais envoyer secrets.toml par mail ni le déposer dans un dépôt de code.
#  Conseil : un compte SQL en lecture seule, limité aux tables utilisées.

[sqlserver]
serveur = 'NOM_DU_SERVEUR'          # avec instance ou port si besoin : 'SRV-DWH01\SQL2019' ou '10.0.0.5,1433'
base = 'DWHBO'                      # base qui contient Validations_load_30mn
utilisateur = 'compte_lecture'
mot_de_passe = 'mot de passe'

# Pilote ODBC installé sur le serveur (liste visible dans « Sources de données ODBC (64 bits) »).
pilote = 'ODBC Driver 17 for SQL Server'

# Chiffrement de la connexion. Avec le pilote 18, le chiffrement est activé par défaut :
# garder faire_confiance_certificat = 'yes' si le serveur n'a pas de certificat reconnu.
chiffrement = 'no'
faire_confiance_certificat = 'yes'

delai_connexion_secondes = 10       # attente maximale pour se connecter
delai_requete_secondes = 60         # durée maximale d'une requête


# ─────────────────────────────────────────────────────────────────────────
# Connexion séparée au serveur qui héberge les PRÉVISIONS
# Même structure ; serveur, base et compte peuvent être différents.
# La requête est définie dans sql/2_previsions.sql.
# ─────────────────────────────────────────────────────────────────────────

[sqlserver_previsions]
serveur = 'NOM_DU_SERVEUR_PREVISIONS'
base = 'BASE_PREVISIONS'
utilisateur = 'compte_lecture_previsions'
mot_de_passe = 'mot de passe'

pilote = 'ODBC Driver 17 for SQL Server'
chiffrement = 'no'
faire_confiance_certificat = 'yes'

delai_connexion_secondes = 10
delai_requete_secondes = 60


# ─────────────────────────────────────────────────────────────────────────
# Connexion GTFS théorique (facultative si les tables GTFS sont dans la base [sqlserver])
# Si les tables calendar/route/stop/stop_time/trip sont dans une autre base ou un autre serveur,
# renseigner cette section avec un compte en lecture seule.
# ─────────────────────────────────────────────────────────────────────────
[sqlserver_gtfs]
serveur = 'NOM_DU_SERVEUR_GTFS'
base = 'BASE_GTFS'
utilisateur = 'compte_lecture_gtfs'
mot_de_passe = 'mot de passe'
pilote = 'ODBC Driver 17 for SQL Server'
chiffrement = 'no'
faire_confiance_certificat = 'yes'
delai_connexion_secondes = 10
delai_requete_secondes = 60
